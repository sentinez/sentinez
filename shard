#!/usr/bin/env bash
set -e

# Repo B (mirror)
REPO_B_URL="https://github.com/sentinez/shared.git"

# Thư mục staging cần sync
PREFIX="staging/src/github.com/sentinez/shared"

# Branch muốn push
BRANCH="dev"

echo "Fetching updates..."
git fetch origin

echo "Pushing subtree '$PREFIX' to Repo B..."
git subtree push --prefix="$PREFIX" "$REPO_B_URL" "$BRANCH"

echo "Done!"
