              "$ref": "#/definitions/v1UpdateResourceRequest"
            }
          }
        ],
        "tags": [
          "TenantService"
        ]
      }
    },
    "/tenant/resource/{resourceDomain}": {
      "get": {
        "operationId": "TenantService_GetResourceByDomain",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1GetResourceByDomainResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/googlerpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "resourceDomain",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "TenantService"
        ]
      }
    },
    "/tenant/resources": {
      "get": {
        "summary": "Lists tenant resources.",
        "operationId": "TenantService_ListResource",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1ListResourceResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/googlerpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "page.index",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "page.size",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "page.total",
            "in": "query",
            "required": false,
            "type": "boolean"
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "type": "string",
            "enum": [
              "STATUS_UNSPECIFIED",
              "STATUS_ACTIVE",
              "STATUS_DISABLE"
            ],
            "default": "STATUS_UNSPECIFIED"
          },
          {
            "name": "resourceName",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "resourceDomain",
            "in": "query",
            "required": false,
            "type": "string"
          }
        ],
        "tags": [
          "TenantService"
        ]
      }
    },
    "/tenant/status": {
      "get": {
        "summary": "Returns service health check status.",
        "operationId": "TenantService_Status",
        "responses": {
          "200": {
            "description": "A successful response.",
