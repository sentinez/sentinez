        "CA_CERTIFICATE_USAGE_CLIENT"
      ],
      "default": "CA_CERTIFICATE_USAGE_UNSPECIFIED",
      "description": " - CA_CERTIFICATE_USAGE_UPSTREAM: Verify the certificates of upstream (origin) servers.\n - CA_CERTIFICATE_USAGE_CLIENT: Verify the client certificates of downstream connections (mTLS)."
    },
