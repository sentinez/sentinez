        },
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "default",
            "in": "query",
            "required": false,
            "type": "boolean"
          }
        ],
        "tags": [
          "TenantService"
        ]
      },
      "delete": {
        "summary": "Deletes a tenant resource.",
