          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1CreateResourceResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/googlerpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1CreateResourceRequest"
            }
          }
        ],
        "tags": [
          "TenantService"
        ]
      },
      "put": {
