      "type": "string",
      "enum": [
        "BALANCE_STRATEGY_UNSPECIFIED",
        "BALANCE_STRATEGY_ROUND_ROBIN"
      ],
      "default": "BALANCE_STRATEGY_UNSPECIFIED"
    },
    "v1CaCertificate": {
      "type": "object",
      "properties": {
        "owner": {
          "$ref": "#/definitions/v1Owner"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "usage": {
          "$ref": "#/definitions/v1CaCertificateUsage",
          "description": "What the edge trusts this CA for."
        },
        "status": {
          "$ref": "#/definitions/typesv1Status",
          "description": "Always STATUS_ACTIVE, set on create."
        },
        "pem": {
          "type": "string",
          "description": "PEM-encoded certificate: exactly one CERTIFICATE block, with\nBasicConstraints CA=true. The source of truth; every parsed field\nbelow is set from it by the service, never by the client. Stored\nencrypted."
        },
        "subject": {
          "type": "string",
          "description": "Subject and issuer distinguished names, in RFC 2253 form."
        },
        "issuer": {
          "type": "string"
        },
        "serialNumber": {
          "type": "string",
          "description": "Serial number, as lowercase hex."
        },
        "fingerprintSha256": {
          "type": "string",
          "description": "SHA-256 of the DER bytes, as lowercase hex."
        },
        "notBefore": {
          "type": "string",
          "format": "date-time"
        },
        "notAfter": {
          "type": "string",
          "format": "date-time"
        },
        "selfSigned": {
          "type": "boolean",
          "description": "Whether subject and issuer are the same (a root CA)."
        },
        "provider": {
          "type": "string",
          "description": "Vendor of the CA: the first organization of the issuer, else its\ncommon name."
        },
        "privateKey": {
          "type": "string",
          "description": "PEM-encoded private key of the certificate, empty without one. Stored\nencrypted and never returned by the API."
        },
        "hasPrivateKey": {
          "type": "boolean",
          "description": "Whether the record holds a private key; set on read, not stored."
        }
      },
      "description": "CaCertificate is one trusted CA certificate of a resource, with its\nprivate key when one was given. A bundle without a key is split into one\nrecord per certificate on import, so the parsed fields below describe\nexactly one certificate and the fingerprint is kept unique per resource.\nA record is immutable: it is only created, read and deleted."
    },
