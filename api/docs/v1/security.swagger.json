    "/security/corerulesets": {
      "get": {
        "summary": "ListCoreRulesets lists OWASP CRS configurations, filtered by their\nname or by the fields of their content",
        "operationId": "SecurityService_ListCoreRulesets",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1ListCoreRulesetsResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/googlerpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "page.index",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "page.size",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "page.total",
            "in": "query",
            "required": false,
            "type": "boolean"
          },
          {
            "name": "name",
            "description": "Case-insensitive part of the name.",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "ids",
            "in": "query",
            "required": false,
            "type": "array",
            "items": {
              "type": "string"
            },
            "collectionFormat": "multi"
          },
          {
            "name": "modes",
            "description": " - ENGINE_MODE_UNSPECIFIED: = OFF\n - ENGINE_MODE_DETECTION_ONLY: log only, never block",
            "in": "query",
            "required": false,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "ENGINE_MODE_UNSPECIFIED",
                "ENGINE_MODE_OFF",
                "ENGINE_MODE_DETECTION_ONLY",
                "ENGINE_MODE_ON"
              ]
            },
            "collectionFormat": "multi"
          },
          {
            "name": "versions",
            "description": " - VERSION_UNSPECIFIED: = latest supported",
            "in": "query",
            "required": false,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "VERSION_UNSPECIFIED",
                "VERSION_V4_16_0",
                "VERSION_V4_17_0"
              ]
            },
            "collectionFormat": "multi"
          },
          {
            "name": "statuses",
            "in": "query",
            "required": false,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "STATUS_UNSPECIFIED",
                "STATUS_ACTIVE",
                "STATUS_DISABLE"
              ]
            },
            "collectionFormat": "multi"
          },
          {
            "name": "paranoiaLevel",
            "description": "content.paranoia_level, 0 = any.",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int64"
          },
          {
            "name": "categories",
            "description": "Rule groups all listed in content.categories.\n\n - CATEGORY_COMMON_EXCEPTIONS: ====== REQUEST PHASE ======\n\n905\n - CATEGORY_METHOD_ENFORCEMENT: 911\n - CATEGORY_SCANNER_DETECTION: 913\n - CATEGORY_PROTOCOL_ENFORCEMENT: 920\n - CATEGORY_PROTOCOL_ATTACK: 921\n - CATEGORY_MULTIPART_ATTACK: 922\n - CATEGORY_LFI: 930\n - CATEGORY_RFI: 931\n - CATEGORY_RCE: 932\n - CATEGORY_PHP: 933\n - CATEGORY_GENERIC: 934\n - CATEGORY_XSS: 941\n - CATEGORY_SQLI: 942\n - CATEGORY_SESSION_FIXATION: 943\n - CATEGORY_JAVA: 944\n - CATEGORY_DATA_LEAKAGES: ====== RESPONSE PHASE ======\n\n950\n - CATEGORY_DATA_LEAKAGES_SQL: 951\n - CATEGORY_DATA_LEAKAGES_JAVA: 952\n - CATEGORY_DATA_LEAKAGES_PHP: 953\n - CATEGORY_DATA_LEAKAGES_IIS: 954\n - CATEGORY_WEB_SHELLS: 955\n - CATEGORY_DATA_LEAKAGES_RUBY: 956",
            "in": "query",
            "required": false,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "CATEGORY_UNSPECIFIED",
                "CATEGORY_COMMON_EXCEPTIONS",
                "CATEGORY_METHOD_ENFORCEMENT",
                "CATEGORY_SCANNER_DETECTION",
                "CATEGORY_PROTOCOL_ENFORCEMENT",
                "CATEGORY_PROTOCOL_ATTACK",
                "CATEGORY_MULTIPART_ATTACK",
                "CATEGORY_LFI",
                "CATEGORY_RFI",
                "CATEGORY_RCE",
                "CATEGORY_PHP",
                "CATEGORY_GENERIC",
                "CATEGORY_XSS",
                "CATEGORY_SQLI",
                "CATEGORY_SESSION_FIXATION",
                "CATEGORY_JAVA",
                "CATEGORY_DATA_LEAKAGES",
                "CATEGORY_DATA_LEAKAGES_SQL",
                "CATEGORY_DATA_LEAKAGES_JAVA",
                "CATEGORY_DATA_LEAKAGES_PHP",
                "CATEGORY_DATA_LEAKAGES_IIS",
                "CATEGORY_WEB_SHELLS",
                "CATEGORY_DATA_LEAKAGES_RUBY"
              ]
            },
            "collectionFormat": "multi"
          },
          {
            "name": "exclusionTags",
            "description": "Tags excluded by content.exclusions.",
            "in": "query",
            "required": false,
            "type": "array",
            "items": {
              "type": "string"
            },
            "collectionFormat": "multi"
          },
          {
            "name": "exclusionRuleIds",
            "description": "Rules with a variable excluded by content.exclusions.",
            "in": "query",
            "required": false,
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int64"
            },
            "collectionFormat": "multi"
          },
          {
            "name": "overrideRuleIds",
