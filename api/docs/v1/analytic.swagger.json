    "/analytic/events/histogram": {
      "get": {
        "summary": "GetEventHistogram counts the events of a kind per time bucket,\nresource and key.",
        "operationId": "AnalyticService_GetEventHistogram",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1GetEventHistogramResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/googlerpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "kind",
            "description": " - EVENT_KIND_HTTP_INGRESS: Requests received by the edge; keyed by the http status.\n - EVENT_KIND_HTTP_EGRESS: Requests proxied to the origins; keyed by the status of the origin.\n - EVENT_KIND_SEC_RULE: Matched SecRules; keyed by the action.\n - EVENT_KIND_RATE_LIMIT: Exceeded rate limiters; keyed by the action.\n - EVENT_KIND_CORE_RULE: Matched core ruleset rules; keyed by the behavior.",
            "in": "query",
            "required": false,
            "type": "string",
            "enum": [
              "EVENT_KIND_UNSPECIFIED",
              "EVENT_KIND_HTTP_INGRESS",
              "EVENT_KIND_HTTP_EGRESS",
              "EVENT_KIND_SEC_RULE",
              "EVENT_KIND_RATE_LIMIT",
              "EVENT_KIND_CORE_RULE"
            ],
            "default": "EVENT_KIND_UNSPECIFIED"
          },
          {
            "name": "resolution",
            "description": " - HISTOGRAM_RESOLUTION_UNSPECIFIED: Picked by the range: seconds for a short zoom within their\nretention, else minutes.",
            "in": "query",
            "required": false,
            "type": "string",
            "enum": [
              "HISTOGRAM_RESOLUTION_UNSPECIFIED",
              "HISTOGRAM_RESOLUTION_SECOND",
              "HISTOGRAM_RESOLUTION_MINUTE",
              "HISTOGRAM_RESOLUTION_HOUR"
            ],
            "default": "HISTOGRAM_RESOLUTION_UNSPECIFIED"
          },
          {
            "name": "resourceIds",
            "in": "query",
            "required": false,
            "type": "array",
            "items": {
              "type": "string"
            },
            "collectionFormat": "multi"
          },
          {
            "name": "from",
            "description": "Bound the start of the buckets, from inclusive, to exclusive.",
            "in": "query",
            "required": false,
            "type": "string",
            "format": "date-time"
          },
          {
            "name": "to",
            "in": "query",
            "required": false,
            "type": "string",
            "format": "date-time"
          }
        ],
        "tags": [
          "AnalyticService"
        ]
      }
    },
