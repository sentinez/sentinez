    "v1EgressEvent": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "upstream": {
          "type": "string",
          "description": "upstream is the origin the request was sent to, e.g.\nhttp://10.0.0.1:8080."
        },
        "method": {
          "type": "string",
          "description": "method, scheme, path and queries are the request once proxied: the\npath is the client one unless the proxy joined the path of upstream\nto it, the scheme is the one of upstream, http or https."
        },
        "scheme": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "queries": {
          "type": "string"
        },
        "status": {
          "type": "integer",
          "format": "int32",
          "description": "status is the one the origin answered, 502 when it was unreachable."
        },
        "contentType": {
          "type": "string"
        },
        "contentLength": {
          "type": "string",
          "format": "int64",
          "description": "content_length is the Content-Length the origin answered, -1 when\nit streamed the body without one."
        },
        "latencyMicros": {
          "type": "string",
          "format": "int64",
          "description": "latency_micros is the time the proxy took to relay the request and\nthe answer of the origin."
        },
        "timestamp": {
          "type": "string",
          "format": "int64",
          "title": "milisec, when the request was sent"
        },
        "resourceId": {
          "type": "string"
        },
        "tenantId": {
          "type": "string"
        },
        "protocol": {
          "type": "string",
          "description": "protocol is the HTTP version the client used to reach the edge, e.g.\nHTTP/2.0: the one used to reach upstream is not observable."
        }
      },
      "description": "EgressEvent is the leg of a request from the reverse proxy to its\nupstream origin, logged once the origin answered; id is the one of\nthe request IngressEvent."
    },
    "v1EventKind": {
      "type": "string",
      "enum": [
        "EVENT_KIND_UNSPECIFIED",
        "EVENT_KIND_HTTP_INGRESS",
        "EVENT_KIND_HTTP_EGRESS",
        "EVENT_KIND_SEC_RULE",
        "EVENT_KIND_RATE_LIMIT",
        "EVENT_KIND_CORE_RULE"
      ],
      "default": "EVENT_KIND_UNSPECIFIED",
      "description": "EventKind the table of the events a histogram counts.\n\n - EVENT_KIND_HTTP_INGRESS: Requests received by the edge; keyed by the http status.\n - EVENT_KIND_HTTP_EGRESS: Requests proxied to the origins; keyed by the status of the origin.\n - EVENT_KIND_SEC_RULE: Matched SecRules; keyed by the action.\n - EVENT_KIND_RATE_LIMIT: Exceeded rate limiters; keyed by the action.\n - EVENT_KIND_CORE_RULE: Matched core ruleset rules; keyed by the behavior."
    },
