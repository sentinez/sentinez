          "$ref": "#/definitions/v1ActionType",
          "description": "@gotags: yaml:\"type\"",
          "title": "Example types: \"block\", \"log\", \"modify_header\",\n\"redirect\", \"set_tag\", \"route_to\""
        },
        "params": {
          "type": "object",
          "description": "@gotags: yaml:\"params\"",
          "title": "Dynamic parameters, e.g., { \"status\": 403, \"message\": \"Forbidden\" }"
