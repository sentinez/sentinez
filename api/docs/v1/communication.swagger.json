          "format": "date-time"
        }
      }
    },
    "v1NotiType": {
      "type": "string",
      "enum": [
        "NOTI_TYPE_UNSPECIFIED",
        "NOTI_TYPE_SUCCESS",
        "NOTI_TYPE_INFO",
        "NOTI_TYPE_WARNING",
        "NOTI_TYPE_ERROR"
      ],
      "default": "NOTI_TYPE_UNSPECIFIED"
    },
    "v1Pages": {
      "type": "object",
