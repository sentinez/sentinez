# What differs from one instance of this service to the next. The env shared by
# all the services (secrets, databases, Kafka, OTLP...) is read from Consul:
# see deploy/consul/shared.env.example and `make consul.env.put`.
# Without SENZ_CONSUL_URI nothing is read from Consul: add the keys of
# deploy/consul/shared.env.example that this service reads to this file.

SENZ_ADDRESS=:9003
SENZ_CONSUL_URI=http://localhost:8500
