# What differs from one instance of this service to the next. The env shared by
# all the services (secrets, databases, Kafka, OTLP...) is read from Consul:
# see deploy/consul/shared.env.example and `make consul.env.put`.
# Without SENZ_CONSUL_URI nothing is read from Consul: add the keys of
# deploy/consul/shared.env.example that this service reads to this file.

SENZ_ADDRESS=:9003
SENZ_CONSUL_URI=http://localhost:8500

# Sync of the tables to the edges (docs/07-controlplane.md): it needs
# SENZ_POSTGRES_URI and SENZ_SYNC_KEY of the shared env.
# Olric addresses of the edges (comma-separated), where the changes are
# published; empty: nothing is published
SENZ_OLRIC_ADDRESSES=
# tables synced, comma-separated; empty: security.secrules,
# security.ratelimits, security.corerulesets, tenant.resources and
# tenant.cacertificates
SENZ_SYNC_TABLES=

# Internal mTLS with the edges: hack/mkcert-internal.sh <dir> centraldata
# localhost <host>. All three, or none (plaintext, for development only)
SENZ_TLS_CA=
SENZ_TLS_CERT=
SENZ_TLS_KEY=
# HMAC key (base64) that signs the service tokens of the edges, only for
# this service, never in the shared env: openssl rand -base64 32
SENZ_SERVICE_KEY=
