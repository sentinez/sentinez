# What differs from one instance of this service to the next. The env shared by
# all the services (secrets, databases, Kafka, OTLP...) is read from Consul:
# see deploy/consul/shared.env.example and `make consul.env.put`.
# Without SZ_CONSUL_URI nothing is read from Consul: add the keys of
# deploy/consul/shared.env.example that this service reads to this file.

SZ_ADDRESS=:9003
SZ_CONSUL_URI=http://sentinez.consul:8500

# Sync of the tables to the edges (docs/07-controlplane.md): it needs
# SZ_POSTGRES_URI and SZ_SYNC_KEY of the shared env.
# Olric of the edges, where the changes are published:
# olric://host:port[,host:port...], or olrics:// through a TLS proxy (Olric
# serves no TLS); empty: nothing is published. The hosts are seeds: one live
# node is enough, the publisher skips a dead one and moves on when it dies. In the cluster of
# deploy/docker/cluster, deploy/docker/centraldata.env sets them
SZ_OLRIC_URI=
# tables synced, comma-separated; empty: security.secrules,
# security.secratelimits, security.secrulesets, tenant.resources and
# tenant.cacertificates
SZ_SYNC_TABLES=

# Internal mTLS with the edges: make sz.centraldata.cert (CN
# sentinez.apps.centraldata). All three, or none (plaintext, development only)
SZ_TLS_CA=
SZ_TLS_CERT=
SZ_TLS_KEY=
# HMAC key (base64) that signs the service tokens of the edges, only for
# this service, never in the shared env: openssl rand -base64 32
SZ_SERVICE_KEY=
