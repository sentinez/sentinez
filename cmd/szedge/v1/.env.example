# What differs from one instance of this service to the next. The env shared by
# all the services (secrets, databases, Kafka, OTLP...) is read from Consul:
# see deploy/consul/shared.env.example and `make consul.env.put`.
# Without SZ_CONSUL_URI nothing is read from Consul: add the keys of
# deploy/consul/shared.env.example that this service reads to this file.

SZ_ADDRESS=:7443
# the Consul of the shared env and of the proxy.yaml (key sentinez/proxy.yaml):
# the edge also elects, through it, the one leading SZ_ZONE
SZ_CONSUL_URI=http://sentinez.consul:8500
SZ_ZONE=SGN
# a clustered edge: both of them (empty: a lone edge)
SZ_MEMBERSHIP_ADDRESS=
SZ_DISCOVERY_ADDRESS=

# Follows centraldata (docs/07-controlplane.md) when SZ_SERVICE_TOKEN is set.
# Token of this edge: SZ_SERVICE_KEY=<key of centraldata> szservicetoken
# -name <CN of the certificate below>; it needs SZ_SYNC_KEY of the shared env
SZ_SERVICE_TOKEN=
# Internal mTLS: hack/mkcert-internal.sh <dir> <CN>. All three, or none
SZ_TLS_CA=
SZ_TLS_CERT=
SZ_TLS_KEY=
