SENZ_ADDRESS=:7443
SENZ_SECRET_KEY=replace-with-your-secret-key
SENZ_MEMBERSHIP_ADDRESS=
SENZ_DISCOVERY_ADDRESS=
# elects the edge leading SENZ_ZONE; required when SENZ_MEMBERSHIP_ADDRESS is set
SENZ_CONSUL_URI=
SENZ_OTLP_EXTERNAL_ENDPOINT=localhost:4317
# produce the traffic events straight to Kafka (takes precedence over OTLP)
SENZ_KAFKA_BROKERS=
SENZ_ZONE=SGN
