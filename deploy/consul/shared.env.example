# Env shared by all the services: put it in the Consul KV once, and every
# service reads it when it starts (see "Config from Consul" in
# docs/02-getting-started.md).
#
#   cp deploy/consul/shared.env.example deploy/consul/shared.env   # then edit
#   make consul.env.put                                            # puts it
#
# deploy/consul/shared.env is ignored by git: it holds secrets. Consul does not
# encrypt the KV, protect these keys with its ACLs.
#
# What differs from one instance to the next stays in cmd/<service>/.env
# (SENZ_ADDRESS, SENZ_CONSUL_URI, SENZ_MEMBERSHIP_ADDRESS,
# SENZ_DISCOVERY_ADDRESS, SENZ_ZONE): Consul does not serve those keys.
#
# The environment of a service wins over Consul, so a key set in its .env (or
# in deploy/docker/*.env) overrides the value here for that service. A key
# that a service does not read is ignored by it.

# Domain of the console, the WebAuthn relying party
SENZ_HOSTNAME=example.com
# Origin of the console: the allowed WebAuthn origin and the only one CORS allows
SENZ_CLIENT_ORIGIN=http://localhost:3000

# HMAC key signing the JWTs, base64
SENZ_SECRET_KEY=replace-with-your-secret-key
# AES-256 key sealing the CA certificates in the database: openssl rand -base64 32
SENZ_DATA_KEY=replace-with-32-random-bytes-in-base64

# HMAC key signing the changes centraldata publishes to the edges, base64: the
# edges drop what is not signed with it. Shared by centraldata and the edges
# only: openssl rand -base64 32
SENZ_SYNC_KEY=replace-with-32-random-bytes-in-base64

# Static admin account
SENZ_ADMIN_USERNAME=admin
SENZ_ADMIN_PASSWORD=admin

# Databases
SENZ_POSTGRES_URI=postgres://user:password@localhost:5432/postgres
SENZ_TIMESCALE_URI=postgres://user:password@localhost:5432/timescale
SENZ_CLICKHOUSE_URI=clickhouse://user:password@localhost:9000/default

# Kafka brokers the edge traffic events go to, and the collector reads from
SENZ_KAFKA_BROKERS=localhost:9094

# OTLP/gRPC collectors: the system logs, and the edge traffic logs
SENZ_OTLP_INTERNAL_ENDPOINT=
SENZ_OTLP_EXTERNAL_ENDPOINT=localhost:4317
