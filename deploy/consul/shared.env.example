# Env shared by all the services: put it in the Consul KV once, and every
# service reads it when it starts (see "Config from Consul" in
# docs/02-getting-started.md).
#
#   cp deploy/consul/shared.env.example deploy/consul/shared.env   # then edit
#   make consul.env.put                                            # puts it
#
# deploy/consul/shared.env is ignored by git: it holds secrets. Consul does not
# encrypt the KV, protect these keys with its ACLs.
#
# What differs from one instance to the next stays in cmd/<service>/.env
# (SZ_ADDRESS, SZ_CONSUL_URI, SZ_MEMBERSHIP_ADDRESS, SZ_DISCOVERY_ADDRESS,
# SZ_OLRIC_ADDRESS, SZ_ZONE): Consul does not serve those keys.
#
# The environment of a service wins over Consul, so a key set in its .env (or
# in deploy/docker/*.env) overrides the value here for that service. A key
# that a service does not read is ignored by it.

# Domain of the console, the WebAuthn relying party
SZ_HOSTNAME=example.com
# Origin of the console: the allowed WebAuthn origin and the only one CORS allows
SZ_CLIENT_ORIGIN=http://localhost:3000

# HMAC key signing the JWTs, base64
SZ_SECRET_KEY=replace-with-your-secret-key
# AES-256 key sealing the CA certificates in the database: openssl rand -base64 32
SZ_DATA_KEY=replace-with-32-random-bytes-in-base64

# HMAC key signing the changes centraldata publishes to the edges, base64: the
# edges drop what is not signed with it. Shared by centraldata and the edges
# only: openssl rand -base64 32
SZ_SYNC_KEY=replace-with-32-random-bytes-in-base64

# Password of the Olric port (3320) of the edges: the edges and centraldata
# hold the same one. Sent in clear (AUTH): keep the port on a private
# network. openssl rand -base64 32
SZ_OLRIC_PASSWORD=replace-with-a-random-password

# AES key encrypting the memberlist gossip of a cluster of edges, base64 of
# 16, 24 or 32 bytes: the edges of a cluster hold the same one.
# openssl rand -base64 32
SZ_GOSSIP_KEY=replace-with-32-random-bytes-in-base64

# Static admin account
SZ_ADMIN_USERNAME=admin
SZ_ADMIN_PASSWORD=admin

# Databases
SZ_POSTGRES_URI=postgres://user:password@sentinez.timescale:5432/postgres
SZ_TIMESCALE_URI=postgres://user:password@sentinez.timescale:5432/timescale
SZ_CLICKHOUSE_URI=clickhouse://user:password@sentinez.clickhouse:9000/default

# Kafka brokers the edge traffic events go to, and the collector reads from:
# kafka://host:port[,host:port...], or kafkas:// for TLS (mTLS with SZ_TLS_*)
SZ_KAFKA_URI=kafka://sentinez.kafka:9094

# OTLP/gRPC collectors: the system logs, and the edge traffic logs;
# http://host:port, or https:// for TLS
SZ_OTLP_INTERNAL_URI=
SZ_OTLP_EXTERNAL_URI=http://sentinez.telemetry.otel-collector:4317
