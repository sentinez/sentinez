{
  "extends": "@sentinez/tsconfig/nextjs.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@sentinez/ui/*": ["../../packages/ui/src/*"],
      "@sentinez/api/*": ["../../packages/api/src/*"],
      "@sentinez/proto/*": ["../../packages/proto/gen/ts/*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "next.config.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
