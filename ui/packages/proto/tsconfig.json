{
  "compilerOptions": {
    "lib": [
      "ES2020"
    ],
    "types": [
      "node"
    ],
    "paths": {
      "@sentinez/proto/*": [
        "./dist/*"
      ]
    },
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "rootDir": "./ts-proto",
    "outDir": "./dist",
    "declaration": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true
  },
  "include": [
    "ts-proto"
  ]
}