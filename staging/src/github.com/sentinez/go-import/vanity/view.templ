package vanity

// metaView is served to `go get` (?go-get=1) and carries only meta tags.
templ metaView(p metaPage) {
	<!DOCTYPE html>
	<html>
		<head>
			<meta charset="utf-8"/>
			<meta name="go-import" content={ p.Root + " git " + p.Repo }/>
			<meta name="go-source" content={ p.source() }/>
		</head>
		<body>go get { p.Root }</body>
	</html>
}

// infoView is the human-readable index or repo page.
templ infoView(p infoPage) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ p.title() }</title>
			<link rel="icon" type="image/png" href="/_static/icon.png"/>
			@infoStyle()
		</head>
		<body>
			<main>
				<a class="logo" href="/">
					<img src="/_static/logo.png" alt={ p.Project } width="180" height="48"/>
				</a>
				if p.Path != "" {
					<p><a href="/">← { p.Project } Go modules</a></p>
					<h1>{ p.Path }</h1>
				} else {
					<h1>{ p.Project } Go modules</h1>
					<p class="lead">{ p.Description }</p>
				}
				for _, repo := range p.Repos {
					@repoCard(repo, p.Path == "")
				}
			</main>
		</body>
	</html>
}

templ repoCard(repo repoView, linked bool) {
	<section class="card">
		<h2>
			if linked {
				<a href={ templ.URL("/" + repo.Name) }>{ repo.Name }</a>
			} else {
				{ repo.Name }
			}
		</h2>
		<p>{ repo.Description }</p>
		<pre>go get { repo.Import }</pre>
		<nav>
			<a href={ templ.URL(repo.Docs) }>Docs</a>
			<a href={ templ.URL(repo.Repo) }>Source</a>
		</nav>
	</section>
}

templ infoStyle() {
	<style>
		:root {
			--bg: #fafafa; --fg: #1a1a1a; --muted: #666;
			--card: #fff; --border: #e5e5e5; --code: #f2f2f2; --link: #0b62d6;
		}
		@media (prefers-color-scheme: dark) {
			:root {
				--bg: #111; --fg: #eee; --muted: #999;
				--card: #1a1a1a; --border: #2a2a2a; --code: #222; --link: #6aa8ff;
			}
			.logo img { filter: brightness(0) invert(1); }
		}
		* { box-sizing: border-box; }
		body {
			margin: 0; background: var(--bg); color: var(--fg);
			font: 16px/1.5 system-ui, -apple-system, "Segoe UI", sans-serif;
		}
		main { max-width: 760px; margin: 0 auto; padding: 48px 16px; }
		.logo { display: inline-block; margin-bottom: 24px; }
		.logo img { display: block; width: 180px; height: auto; }
		h1 { margin: 0 0 8px; font-size: 28px; }
		p.lead { margin: 0 0 32px; color: var(--muted); }
		.card {
			background: var(--card); border: 1px solid var(--border);
			border-radius: 8px; padding: 16px 20px; margin-bottom: 12px;
		}
		.card h2 { margin: 0 0 4px; font-size: 18px; }
		.card p { margin: 0 0 12px; color: var(--muted); }
		code, pre {
			font: 14px/1.5 ui-monospace, SFMono-Regular, Menlo, monospace;
		}
		pre {
			margin: 0 0 12px; padding: 8px 12px; overflow-x: auto;
			background: var(--code); border-radius: 6px;
		}
		a { color: var(--link); text-decoration: none; }
		a:hover { text-decoration: underline; }
		nav a { margin-right: 16px; font-size: 14px; }
	</style>
}
