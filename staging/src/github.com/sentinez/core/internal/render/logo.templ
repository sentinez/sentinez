package render

// logo renders the Sentinéz mark inline so error pages need no asset fetch.
templ logo() {
	<svg
		xmlns="http://www.w3.org/2000/svg"
		viewBox="0 0 1040 1040"
		width="120"
		height="120"
		role="img"
		aria-label="Logo"
		style="flex-shrink: 0; margin-right: 2rem;"
	>
		<g fill="#0504AA">
			<rect x="120" y="120" width="80" height="800"></rect>
			<rect x="240" y="280" width="80" height="600"></rect>
			<rect x="360" y="360" width="80" height="480"></rect>
			<rect x="480" y="120" width="80" height="800"></rect>
			<rect x="600" y="360" width="80" height="480"></rect>
			<rect x="720" y="280" width="80" height="600"></rect>
			<rect x="840" y="120" width="80" height="800"></rect>
		</g>
	</svg>
}
