package templx

templ notFound() {
	<div style="display: flex; align-items: center; padding: 2rem;">
		<img src="https://i.imgur.com/GXItvHZ.png" alt="Logo" style="max-width: 120px; margin-right: 2rem;" />
		<div>
			<h1>404 Not Found</h1>
			<p>The page you are looking for could not be found.</p>
		</div>
	</div>
}

templ NotFound() {
	@View("404 | sentinez", notFound())
}
